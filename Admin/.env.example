# All optional. The console calls the API on its own origin (/v1/...), so there is no API URL to set.
# Google, Facebook and email + password sign-in are configured on the server and read from
# GET /v1/admin/auth/methods - nothing to set here for them.
# Single sign-on can also be configured at deploy time in /admin/config.json (see public/config.example.json),
# which wins over these build-time values.
VITE_SSO_AUTHORITY=
VITE_SSO_CLIENT_ID=
VITE_SSO_RESPONSE_TYPE=code
VITE_SSO_PROVIDER_NAME=
# "true" offers the environment's access key under "Other ways to sign in" (config.json: "accessKey": true).
VITE_ADMIN_ACCESS_KEY=
# Dev server only: where /v1 is proxied.
VITE_DEV_API=https://stylemint.voyageritnepal.com
